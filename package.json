{
  "name": "yuki-theme",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "wallpapers": "node scripts/generate-wallpapers.mjs"
    ,"wallpapers:import": "node scripts/import-wallpapers.mjs"
    ,"wallpapers:palette": "node scripts/extract-palettes.mjs"
,"wallpapers:sizes": "node scripts/record-wallpaper-sizes.mjs"
,"wallpapers:video": "node scripts/import-wallpaper-videos.mjs"
