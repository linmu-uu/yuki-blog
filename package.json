    ,"wallpapers:variants": "node scripts/make-wallpaper-variants.mjs"
    ,"wallpapers:generate": "node scripts/generate-original-wallpapers.mjs"
    ,"wallpapers:ai": "node scripts/prepare-ai-wallpapers.mjs"
    ,"gallery:thumbs": "node scripts/make-gallery-thumbs.mjs"
