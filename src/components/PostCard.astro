---
interface Props {
	title: string;
	description?: string;
	href: string;
	published: Date;
	category?: string;
	tags?: string[];
	image?: string;
	delay?: number;
	variant?: number;
	slug?: string;
}

const {
	title,
	description = "",
	href,
	published,
	category = "",
	tags = [],
	image = "",
	delay = 0,
	variant = 0,
	slug = "",
} = Astro.props;

const dateLabel = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
}).format(published);
---

<article class="post-card card" data-reveal style={`--reveal-delay:${delay}ms`}>
	<a class="post-card__link" href={href}>
		<div class="post-card__cover" transition:name={slug ? `cover-${slug}` : undefined}>
			{
				image ? (
					<img src={image} alt="" loading="lazy" decoding="async" />
				) : (
					<span class="post-card__mark" aria-hidden="true" data-variant={variant % 3}>
						<svg viewBox="0 0 100 100">
							<g transform="translate(50 50)">
								<ellipse cx="0" cy="-24" rx="12" ry="21" />
								<ellipse cx="0" cy="-24" rx="12" ry="21" transform="rotate(72)" />
								<ellipse cx="0" cy="-24" rx="12" ry="21" transform="rotate(144)" />
								<ellipse cx="0" cy="-24" rx="12" ry="21" transform="rotate(216)" />
								<ellipse cx="0" cy="-24" rx="12" ry="21" transform="rotate(288)" />
							</g>
							<circle cx="50" cy="50" r="7" class="post-card__mark-core" />
						</svg>
					</span>
				)
			}
		</div>
		<div class="post-card__body">
			<div class="post-card__meta">
				<time datetime={published.toISOString()}>{dateLabel}</time>
				{category && <span class="post-card__category">{category}</span>}
			</div>
			<h3 class="post-card__title" transition:name={slug ? `title-${slug}` : undefined}>{title}</h3>
			{description && <p class="post-card__desc">{description}</p>}
			{
				tags.length > 0 && (
					<ul class="post-card__tags">
						{tags.slice(0, 3).map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)
			}
		</div>
	</a>
</article>

<style>
	.post-card {
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		transform-style: preserve-3d;
		overflow: hidden;
		transition:
			transform var(--dur-slow) var(--ease-spring),
			border-color var(--dur-slow) var(--ease-soft),
			box-shadow var(--dur-slow) var(--ease-soft);
	}

	.post-card:hover {
		transform: perspective(1100px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y)) translateY(-5px);
		border-color: rgba(95, 225, 255, 0.45);
		box-shadow: var(--glow-accent);
	}

	.post-card__link {
		display: grid;
		grid-template-columns: 216px 1fr;
		gap: var(--space-5);
		align-items: center;
		padding: var(--space-4);
	}

	.post-card__cover {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 11;
		border-radius: var(--radius-sm);
		overflow: hidden;
		border: 1px solid var(--border);
		background:
			radial-gradient(120% 120% at 18% 12%, rgba(var(--cover-a), 0.4), transparent 62%),
			radial-gradient(120% 120% at 88% 88%, rgba(var(--cover-b), 0.28), transparent 60%),
			linear-gradient(140deg, #1b1330, #120f22);
	}

	/* 三套封面配色轮换，避免所有卡片长得一样 */
	.post-card:nth-child(3n + 1) .post-card__cover {
		--cover-a: 18, 138, 250;
		--cover-b: 95, 225, 255;
	}

	.post-card:nth-child(3n + 2) .post-card__cover {
		--cover-a: 95, 225, 255;
		--cover-b: 255, 224, 138;
	}

	.post-card:nth-child(3n + 3) .post-card__cover {
		--cover-a: 109, 94, 252;
		--cover-b: 18, 138, 250;
	}

	.post-card__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-slow) var(--ease-spring);
	}

	.post-card:hover .post-card__cover img {
		transform: scale(1.06);
	}

	/* 悬停时封面上一道光扫过 */
	.post-card__cover::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			115deg,
			transparent 40%,
			rgba(220, 240, 255, 0.28) 50%,
			transparent 60%
		);
		background-size: 240% 100%;
		background-position: 150% 0;
		opacity: 0;
		transition:
			background-position 900ms var(--ease-glide),
			opacity 260ms var(--ease-soft);
	}

	.post-card:hover .post-card__cover::after {
		opacity: 1;
		background-position: -50% 0;
	}

	.post-card__mark {
		width: 64px;
		height: 64px;
		opacity: 0.9;
		/* 和卡片抬起用同一条曲线、同一个时长，整张卡片是一起动的 */
		transition:
			transform var(--dur-slow) var(--ease-spring),
			filter var(--dur-slow) var(--ease-soft),
			opacity var(--dur-slow) var(--ease-soft);
	}

	.post-card:hover .post-card__mark {
		/* 五瓣花转 72° 正好是自身对称角度：转完看不出尽头，像一直在转 */
		transform: rotate(72deg) scale(1.12);
		opacity: 1;
		filter: drop-shadow(0 10px 26px rgba(var(--accent-rgb), 0.75));
	}

	.post-card__mark svg {
		width: 100%;
		height: 100%;
		fill: rgba(255, 255, 255, 0.86);
		filter: drop-shadow(0 8px 20px rgba(var(--accent-rgb), 0.45));
	}

	.post-card__mark[data-variant="1"] svg {
		filter: drop-shadow(0 8px 20px rgba(95, 225, 255, 0.45));
	}

	.post-card__mark[data-variant="2"] svg {
		filter: drop-shadow(0 8px 20px rgba(95, 225, 255, 0.45));
	}

	.post-card__mark-core {
		fill: rgba(18, 16, 31, 0.75);
	}

	.post-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-width: 0;
	}

	.post-card__meta {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--text-xs);
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
	}

	.post-card__category {
		padding: 2px 10px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(95, 225, 255, 0.35);
		background: rgba(95, 225, 255, 0.12);
		color: var(--accent-3);
	}

	.post-card__title {
		margin: 0;
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: 1.35;
		transition: color var(--dur) var(--ease-soft);
	}

	.post-card:hover .post-card__title {
		color: var(--accent-soft);
	}

	.post-card__desc {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.75;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card__tags {
		display: flex;
		gap: var(--space-3);
		margin: var(--space-1) 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-xs);
		color: var(--text-dim);
	}

	@media (max-width: 768px) {
		.post-card__link {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}

		.post-card__cover {
			aspect-ratio: 16 / 9;
		}
	}
</style>
