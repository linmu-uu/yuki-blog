---
import { site } from "../data/site";
---

<section class="card music" data-reveal style="--reveal-delay:240ms">
	<h2 class="section-title">{site.music.title}</h2>

	<div class="music__player">
		<img class="music__cover" data-cover src={site.music.cover} alt="封面" width="56" height="56" loading="lazy" decoding="async" />
		<div class="music__meta">
			<span class="music__track" data-title>点播放开始听</span>
			<span class="music__time" data-time>00:00 / 00:00</span>
		</div>
		<div class="music__controls">
			<button class="music__step" type="button" data-prev aria-label="上一首">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M7 6v12M19 6l-9 6 9 6V6Z" fill="currentColor"></path>
				</svg>
			</button>
			<button
				class="music__play"
				type="button"
				data-play
				aria-label="播放背景音乐"
				aria-pressed="false"
			>
				<svg class="music__icon music__icon--play" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"></path>
				</svg>
				<svg class="music__icon music__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"></path>
				</svg>
			</button>
			<button class="music__step" type="button" data-next aria-label="下一首">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M17 6v12M5 6l9 6-9 6V6Z" fill="currentColor"></path>
				</svg>
			</button>
		</div>
	</div>

	<span class="music__eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

	<div class="music__bar" data-bar title="点一下可以跳到想听的地方">
		<div class="music__progress" data-progress></div>
	</div>

	<p class="music__hint" data-hint hidden></p>
</section>

<style>
	.music {
		padding: var(--space-5);
	}

	.music__player {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.music__cover {
		width: 56px;
		height: 56px;
		border-radius: var(--radius-sm);
		object-fit: cover;
		border: 1px solid var(--border);
		flex-shrink: 0;
	}

	.music__meta {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}

	.music__track {
		font-size: var(--text-sm);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.music__time {
		font-size: var(--text-xs);
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
	}

	.music__controls {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		flex-shrink: 0;
	}

	.music__step {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		color: var(--text-muted);
		transition:
			color var(--dur) var(--ease-soft),
			transform var(--dur) var(--ease-spring);
	}

	.music__step svg {
		width: 16px;
		height: 16px;
	}

	.music__step:hover {
		color: var(--text);
		transform: scale(1.08);
	}

	.music__play {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		color: #12101f;
		background: var(--gradient-accent);
		box-shadow: 0 12px 28px -14px rgba(var(--accent-rgb), 0.9);
		transition: transform var(--dur) var(--ease-out);
	}

	.music__play:hover {
		transform: scale(1.06);
	}

	.music__icon {
		width: 20px;
		height: 20px;
		grid-area: 1 / 1;
	}

	.music__icon--pause {
		display: none;
	}

	.music.is-playing .music__icon--play {
		display: none;
	}

	.music.is-playing .music__icon--pause {
		display: block;
	}

	.music__bar {
		position: relative;
		height: 4px;
		margin-top: var(--space-4);
		border-radius: var(--radius-full);
		background: rgba(255, 255, 255, 0.08);
		overflow: hidden;
		cursor: pointer;
	}

	/* 进度条本体只有 4px 高，往上下各扩一圈看不见的热区，点起来才不费劲 */
	.music__bar::before {
		content: "";
		position: absolute;
		inset: -9px 0;
	}

	/* 播放时跳动的均衡器 */
	.music__eq {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 14px;
		margin-top: var(--space-3);
		opacity: 0;
		transition: opacity var(--dur) var(--ease-soft);
	}

	.music.is-playing .music__eq {
		opacity: 1;
	}

	.music__eq i {
		width: 3px;
		height: 14px;
		border-radius: 2px;
		background: var(--gradient-accent);
		/* 用 scaleY 而不是动 height：不触发重排，动画更稳 */
		transform: scaleY(0.28);
		transform-origin: bottom;
	}

	.music.is-playing .music__eq i {
		animation: eq-bounce 900ms var(--ease-soft) infinite;
	}

	.music.is-playing .music__eq i:nth-child(2) {
		animation-delay: 140ms;
	}

	.music.is-playing .music__eq i:nth-child(3) {
		animation-delay: 280ms;
	}

	.music.is-playing .music__eq i:nth-child(4) {
		animation-delay: 420ms;
	}

	@keyframes eq-bounce {
		0%,
		100% {
			transform: scaleY(0.28);
		}
		50% {
			transform: scaleY(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.music.is-playing .music__eq i {
			animation: none;
			transform: scaleY(0.7);
		}
	}

	.music__progress {
		height: 100%;
		width: 0;
		border-radius: var(--radius-full);
		background: var(--gradient-accent);
		transition: width 200ms linear;
	}

	.music__hint {
		margin: var(--space-2) 0 0;
		font-size: var(--text-xs);
		color: var(--text-dim);
	}

</style>

<script>
	import { site } from "../data/site";
	import {
		configureMusic,
		loadRemotePlaylist,
		nextMusic,
		prevMusic,
		seekMusic,
		subscribeMusic,
		toggleMusic,
		warmUpMusic,
	} from "../scripts/music";

	const format = (seconds: number) => {
		if (!Number.isFinite(seconds) || seconds <= 0) return "00:00";
		const m = Math.floor(seconds / 60);
		const s = Math.floor(seconds % 60);
		return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
	};

	let remoteRequested = false;

	const setupMusic = () => {
		const card = document.querySelector<HTMLElement>(".music");
		if (!card) return;

		const cover = card.querySelector<HTMLImageElement>("[data-cover]");
		const title = card.querySelector<HTMLElement>("[data-title]");
		const time = card.querySelector<HTMLElement>("[data-time]");
		const playButton = card.querySelector<HTMLButtonElement>("[data-play]");
		const hint = card.querySelector<HTMLElement>("[data-hint]");
		const bar = card.querySelector<HTMLElement>("[data-bar]");
		const progress = card.querySelector<HTMLElement>("[data-progress]");

		/*
		 * 有远程歌单的话，等音乐卡快滚进视口再去拉：
		 * 一次跨境的歌单请求 + 封面图，别跟首屏大图抢带宽（卡片本来就在首屏下面）。
		 */
		if (site.music.api && !remoteRequested) {
			const startRemote = () => {
				if (remoteRequested) return;
				remoteRequested = true;
				warmUpMusic();
				void loadRemotePlaylist(site.music.api, site.music.cover);
			};

			if ("IntersectionObserver" in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						if (!entries.some((entry) => entry.isIntersecting)) return;
						observer.disconnect();
						startRemote();
					},
					{ rootMargin: "400px 0px" },
				);
				observer.observe(card);
			} else {
				startRemote();
			}
		}

		if (card.dataset.bound !== "1") {
			card.dataset.bound = "1";
			card.addEventListener("pointerenter", warmUpMusic, { once: true });

			playButton?.addEventListener("click", () => toggleMusic());
			card.querySelector("[data-prev]")?.addEventListener("click", () => prevMusic());
			card.querySelector("[data-next]")?.addEventListener("click", () => nextMusic());

			bar?.addEventListener("click", (event) => {
				const rect = bar.getBoundingClientRect();
				const ratio = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
				seekMusic(ratio);
			});
		}

		const unsubscribe = subscribeMusic((state) => {
			if (!card.isConnected) {
				unsubscribe();
				return;
			}

			const track = state.tracks[state.index];
			card.classList.toggle("is-playing", state.playing);
			playButton?.setAttribute("aria-pressed", String(state.playing));
			playButton?.setAttribute("aria-label", state.playing ? "暂停背景音乐" : "播放背景音乐");

			if (track) {
				if (title) title.textContent = track.title;
				if (cover && cover.getAttribute("src") !== track.cover) cover.src = track.cover;
			}

			if (time) time.textContent = `${format(state.time)} / ${format(state.duration)}`;
			if (progress && state.duration > 0) {
				progress.style.width = `${(state.time / state.duration) * 100}%`;
			}

			const message = state.error || (!state.tracks.length ? "还没有歌单喵～" : "");
			if (hint) {
				hint.textContent = message;
				hint.hidden = !message;
			}
		});
	};

	configureMusic([]);
	setupMusic();
	document.addEventListener("astro:page-load", setupMusic);
</script>
