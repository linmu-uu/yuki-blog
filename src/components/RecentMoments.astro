---
import { site } from "../data/site";
import { moments } from "../data/moments";

/** 构建时先用本地种子数据渲染，页面打开后再用后端的最新数据覆盖 */
const items = moments.slice(0, 3);

const label = (date: string) => {
	const [datePart = "", timePart = ""] = date.split(" ");
	const [, month, day] = datePart.split("-");
	return `${Number(month)}/${Number(day)} ${timePart}`;
};
---

<section class="card recent" data-recent data-api={site.momentsApi} style="--reveal-delay:260ms">
	<header class="recent__head">
		<h2 class="section-title">最近动态</h2>
		<a class="recent__more" href="/moments">全部 →</a>
	</header>

	<ol class="recent__list" data-recent-list>
		{
			items.map((item) => (
				<li class="recent__item">
					<span class="recent__time">{label(item.date)}</span>
					<p class="recent__text">{item.content}</p>
					{item.mood && <span class="recent__mood">{item.mood}</span>}
				</li>
			))
		}
	</ol>

	<p class="recent__empty" data-recent-empty hidden>还没有动态喵～</p>
</section>

<style>
	.recent {
		padding: var(--space-5);
	}

	.recent__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.recent__more {
		font-size: var(--text-xs);
		color: var(--accent-soft);
		transition: color var(--dur) var(--ease-soft);
	}

	.recent__more:hover {
		color: var(--accent);
	}

	.recent__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
	}

	.recent__item {
		position: relative;
		padding-left: var(--space-4);
	}

	/* 左边一条小时间线 */
	.recent__item::before {
		content: "";
		position: absolute;
		left: 0;
		top: 6px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--gradient-accent);
		box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.8);
	}

	.recent__time {
		font-size: var(--text-xs);
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
	}

	.recent__text {
		margin: 2px 0 0;
		font-size: var(--text-xs);
		line-height: 1.75;
		color: var(--text-soft);
		/* 最多两行，超出省略 */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.recent__mood {
		display: inline-block;
		margin-top: 4px;
		padding: 1px 8px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(var(--halo-rgb), 0.4);
		background: rgba(var(--halo-rgb), 0.12);
		font-size: 10px;
		color: var(--accent-3);
	}

	.recent__empty {
		margin: var(--space-4) 0 0;
		font-size: var(--text-xs);
		color: var(--text-dim);
	}
</style>

<script>
	interface RemoteMoment {
		date: string;
		content: string;
		mood?: string;
	}

	const setupRecent = () => {
		const card = document.querySelector<HTMLElement>("[data-recent]");
		if (!card || card.dataset.bound === "1") return;
		card.dataset.bound = "1";

		const api = card.dataset.api;
		const list = card.querySelector<HTMLElement>("[data-recent-list]");
		const empty = card.querySelector<HTMLElement>("[data-recent-empty]");
		if (!api || !list) return;

		const label = (date: string) => {
			const [datePart = "", timePart = ""] = date.split(" ");
			const [, month, day] = datePart.split("-");
			return `${Number(month)}/${Number(day)} ${timePart}`.trim();
		};

		void fetch(`${api}/api/moments`, { cache: "no-store" })
			.then((response) => (response.ok ? response.json() : null))
			.then((data: RemoteMoment[] | null) => {
				if (!Array.isArray(data)) return;
				if (!data.length) {
					list.replaceChildren();
					if (empty) empty.hidden = false;
					return;
				}
				if (empty) empty.hidden = true;

				list.replaceChildren(
					...data.slice(0, 3).map((item) => {
						const li = document.createElement("li");
						li.className = "recent__item";

						const time = document.createElement("span");
						time.className = "recent__time";
						time.textContent = label(item.date ?? "");

						const text = document.createElement("p");
						text.className = "recent__text";
						text.textContent = item.content ?? "";

						li.append(time, text);

						if (item.mood) {
							const mood = document.createElement("span");
							mood.className = "recent__mood";
							mood.textContent = item.mood;
							li.append(mood);
						}

						return li;
					}),
				);
			})
			.catch(() => {
				// 拉不到就保留构建时渲染的那几条
			});
	};

	setupRecent();
	document.addEventListener("astro:page-load", setupRecent);
</script>
