---
import { site } from "../data/site";

const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="shell site-header__inner">
		<a class="brand" href="/">
			<span class="brand__mark" aria-hidden="true">
				<svg viewBox="0 0 32 32" fill="none">
					<path
						d="M16 8.2c-4.7 0-8.5 1.4-8.5 3.1s3.8 3.1 8.5 3.1 8.5-1.4 8.5-3.1-3.8-3.1-8.5-3.1Zm0 4.9c-4.1 0-7-1-7-1.8s2.9-1.8 7-1.8 7 1 7 1.8-2.9 1.8-7 1.8Z"
						fill="currentColor"></path>
					<path
						d="M16 15.2c.5 3.9 3.2 6.6 7.1 7.1-3.9.5-6.6 3.2-7.1 7.1-.5-3.9-3.2-6.6-7.1-7.1 3.9-.5 6.6-3.2 7.1-7.1Z"
						fill="currentColor"></path>
				</svg>
			</span>
			<span class="brand__text">
				<span class="brand__name">{site.title}</span>
				<span class="brand__sub">{site.subtitle}</span>
			</span>
		</a>

		<nav class="nav" id="site-nav">
			{
				site.nav.map((item) => (
					<a class:list={["nav__link", { "is-active": path === item.href }]} href={item.href}>
						{item.label}
					</a>
				))
			}
		</nav>

		<button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
			<span class="nav-toggle__bars" aria-hidden="true"></span>
			<span class="sr-only">打开导航菜单</span>
		</button>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		border-bottom: 1px solid transparent;
		transition:
			background var(--dur) var(--ease-soft),
			border-color var(--dur) var(--ease-soft),
			backdrop-filter var(--dur) var(--ease-soft);
	}

	.site-header.is-scrolled {
		background: rgba(8, 7, 15, 0.72);
		border-bottom-color: var(--border);
		backdrop-filter: blur(16px) saturate(140%);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		min-height: var(--header-height);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.brand__mark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-sm);
		color: var(--accent);
		background: var(--gradient-soft);
		border: 1px solid var(--border);
		transition: transform var(--dur) var(--ease-out);
	}

	.brand:hover .brand__mark {
		transform: rotate(-8deg) scale(1.06);
	}

	.brand__mark svg {
		width: 24px;
		height: 24px;
	}

	.brand__text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.brand__name {
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.brand__sub {
		font-size: var(--text-xs);
		color: var(--text-dim);
		letter-spacing: 0.16em;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	.nav__link {
		position: relative;
		padding: 8px 14px;
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
		color: var(--text-muted);
		transition:
			color var(--dur) var(--ease-soft),
			background var(--dur) var(--ease-soft);
	}

	.nav__link:hover {
		color: var(--text);
		background: var(--surface);
	}

	.nav__link.is-active {
		color: var(--text);
		background: var(--surface);
		box-shadow: inset 0 0 0 1px var(--border);
	}

	/* 悬停/选中时下划线从左侧扫出 */
	.nav__link::after {
		content: "";
		position: absolute;
		left: 14px;
		right: 14px;
		bottom: 3px;
		height: 1.5px;
		border-radius: 2px;
		background: var(--gradient-accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition: transform var(--dur) var(--ease-spring);
	}

	.nav__link:hover::after,
	.nav__link.is-active::after {
		transform: scaleX(1);
	}

	.nav-toggle {
		display: none;
		width: 42px;
		height: 42px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: var(--surface);
		place-items: center;
	}

	.nav-toggle__bars,
	.nav-toggle__bars::before,
	.nav-toggle__bars::after {
		display: block;
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: var(--text-soft);
	}

	.nav-toggle__bars::before,
	.nav-toggle__bars::after {
		content: "";
		position: relative;
	}

	.nav-toggle__bars::before {
		top: -6px;
	}

	.nav-toggle__bars::after {
		top: 4px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	@media (max-width: 900px) {
		.nav-toggle {
			display: grid;
		}

		.nav {
			position: absolute;
			inset: var(--header-height) 16px auto 16px;
			flex-direction: column;
			align-items: stretch;
			padding: var(--space-3);
			border-radius: var(--radius);
			border: 1px solid var(--border);
			background: rgba(11, 9, 20, 0.94);
			backdrop-filter: blur(18px);
			box-shadow: var(--shadow-lift);
			opacity: 0;
			transform: translateY(-10px);
			pointer-events: none;
			transition:
				opacity var(--dur) var(--ease-out),
				transform var(--dur) var(--ease-out);
		}

		.nav.is-open {
			opacity: 1;
			transform: none;
			pointer-events: auto;
		}

		.nav__link {
			padding: 12px 16px;
		}
	}
</style>

<script>
	const syncActiveLink = () => {
		const path = window.location.pathname;
		for (const link of document.querySelectorAll<HTMLAnchorElement>(".nav__link")) {
			const href = link.getAttribute("href") ?? "/";
			link.classList.toggle("is-active", href === path);
		}
	};

	const setupHeader = () => {
		const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
		const nav = document.getElementById("site-nav");

		if (toggle && toggle.dataset.bound !== "1") {
			toggle.dataset.bound = "1";
			toggle.addEventListener("click", () => {
				const open = nav?.classList.toggle("is-open") ?? false;
				toggle.setAttribute("aria-expanded", String(open));
			});
		}

		// 切页后收起移动端菜单，并更新高亮
		nav?.classList.remove("is-open");
		toggle?.setAttribute("aria-expanded", "false");
		syncActiveLink();
	};

	setupHeader();
	document.addEventListener("astro:page-load", setupHeader);
</script>
