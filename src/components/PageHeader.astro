---
interface Props {
	title: string;
	description?: string;
	meta?: string;
}

const { title, description = "", meta = "" } = Astro.props;
---

<header class="page-header">
	<div class="shell page-header__inner">
		<h1 class="page-header__title">{title}</h1>
		{description && <p class="page-header__desc">{description}</p>}
		{meta && <p class="page-header__meta">{meta}</p>}
	</div>
</header>

<style>
	.page-header {
		position: relative;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
		background:
			radial-gradient(60% 120% at 12% 0%, rgba(95, 225, 255, 0.22), transparent 62%),
			radial-gradient(55% 120% at 88% 10%, rgba(95, 225, 255, 0.16), transparent 60%),
			linear-gradient(180deg, rgba(13, 11, 25, 0.9), rgba(8, 7, 15, 0.4));
	}

	.page-header__inner {
		padding-block: var(--space-8) var(--space-7);
	}

	.page-header__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 12px 30px rgba(var(--accent-rgb), 0.2));
	}

	.page-header__desc {
		max-width: 62ch;
		margin: var(--space-4) 0 0;
		font-size: var(--text-sm);
		line-height: 1.8;
		color: var(--text-muted);
	}

	.page-header__meta {
		margin: var(--space-2) 0 0;
		font-size: var(--text-xs);
		letter-spacing: 0.1em;
		color: var(--text-dim);
	}
</style>
