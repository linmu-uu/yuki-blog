---
import { site } from "../data/site";

interface Props {
	title?: string;
}

const { title = "留言" } = Astro.props;
---

<section class="comments" id="comments">
	<h2 class="section-title">{title}</h2>
	<div id="tcomment" class="comments__mount" data-comments-mount>评论加载中…</div>
</section>

<style>
	.comments {
		margin-top: var(--space-7);
	}

	.comments__mount {
		min-height: 120px;
	}

	/* 还没开始加载时的占位文案（Twikoo 接管后会清掉） */
	.comments__mount:not([data-ready="1"]) {
		font-size: var(--text-sm);
		color: var(--text-dim);
	}
</style>

<script>
	import { site } from "../data/site";

	const ENV_ID = site.twikooApi;
	const STYLES = ["/assets/css/twikoo.css", "/assets/css/twikoo-theme.css"];
	const SCRIPT = "/assets/js/twikoo.nocss.js";

	interface TwikooGlobal {
		init: (options: Record<string, unknown>) => Promise<unknown>;
	}

	/**
	 * 评论是最重的一块资源（JS 约 170KB + 样式），所以不做首屏加载：
	 * 等留言区快滚进视口时再把资源插进来，首页和文章首屏就省下了这笔开销。
	 */
	let scriptPromise: Promise<void> | null = null;

	/** 脚本只需要加载一次（浏览器会缓存，这里再用 promise 兜底） */
	const loadScript = () => {
		if (scriptPromise) return scriptPromise;

		scriptPromise = new Promise<void>((resolve) => {
			if (document.querySelector(`script[src="${SCRIPT}"]`)) {
				resolve();
				return;
			}

			const script = document.createElement("script");
			script.src = SCRIPT;
			script.async = true;
			script.addEventListener("load", () => resolve(), { once: true });
			script.addEventListener("error", () => resolve(), { once: true });
			document.head.appendChild(script);
		});

		return scriptPromise;
	};

	/**
	 * 样式表**每次都要重新确认**，不能像脚本那样只做一次。
	 *
	 * ClientRouter 切页时会拿新页面的 <head> 去替换旧的，我们动态插进去的 <link>
	 * 会被顺手删掉；而 promise 一旦 resolved 就不会再插第二次。
	 * 结果是第二次进留言页时「有 JS 没 CSS」：评论框和列表变成一坨没样式的文字，
	 * 头像还会撑成一个大圆，只有整页刷新才能恢复。
	 */
	const ensureStyles = () =>
		Promise.all(
			STYLES.map(
				(href) =>
					new Promise<void>((resolve) => {
						const existing = document.querySelector<HTMLLinkElement>(`link[href="${href}"]`);
						if (existing?.sheet) {
							resolve();
							return;
						}

						const link = existing ?? document.createElement("link");
						if (!existing) {
							link.rel = "stylesheet";
							link.href = href;
							document.head.appendChild(link);
						}
						link.addEventListener("load", () => resolve(), { once: true });
						link.addEventListener("error", () => resolve(), { once: true });
					}),
			),
		);

	const twikooGlobal = () => (window as unknown as { twikoo?: TwikooGlobal }).twikoo;

	const waitForGlobal = () =>
		new Promise<TwikooGlobal | null>((resolve) => {
			let tries = 0;
			const check = () => {
				const global = twikooGlobal();
				if (global) {
					resolve(global);
					return;
				}
				tries += 1;
				if (tries > 80) {
					resolve(null);
					return;
				}
				window.setTimeout(check, 120);
			};
			check();
		});

	const currentPath = () => {
		const path = window.location.pathname;
		return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
	};

	/**
	 * Twikoo 的 DOM 是它自己渲染的，有几处无障碍/SEO 小毛病，接管后顺手补掉。
	 *
	 * Lighthouse 实测（留言板页）：无障碍 89、SEO 92 全是下面三条拖的——
	 *   1. `label`：评论输入框没有可访问名称（它只给了 placeholder）
	 *   2. `link-name`：Markdown 说明的链接只有 `alt` 属性、没有可读文本
	 *   3. `crawlable-anchors`：管理面板的关闭按钮是没 `href` 的 `<a>`
	 */
	const polishTwikoo = () => {
		/*
		 * 注意：Twikoo 会把我们给的 `#tcomment` 整个换成它自己的 `#twikoo`，
		 * 所以这里要在**外层 section** 里找元素，别去找 `#tcomment`（那时它已经不存在了）。
		 */
		const mount =
			document.getElementById("comments") ??
			document.getElementById("twikoo") ??
			document.getElementById("tcomment");
		if (!mount) return;

		// 1) 输入框：没有 label 也没有 aria-label 的，补一个可访问名称
		for (const field of mount.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("textarea, input")) {
			if (field.getAttribute("aria-label") || field.getAttribute("aria-labelledby")) continue;
			if (field.id && mount.querySelector(`label[for="${field.id}"]`)) continue;
			const placeholder = field.getAttribute("placeholder")?.trim();
			field.setAttribute(
				"aria-label",
				placeholder || (field.tagName === "TEXTAREA" ? "评论内容" : "评论输入框"),
			);
		}

		// 2) 纯图标链接：把原本写在 alt 里的说明挪成 aria-label
		for (const link of mount.querySelectorAll<HTMLElement>("a")) {
			if (link.textContent?.trim() || link.getAttribute("aria-label")) continue;
			const alt = link.getAttribute("alt")?.trim();
			if (alt) link.setAttribute("aria-label", alt);
		}

		// 3) 没有 href 的 <a>（关闭按钮这类）：补一个可爬的地址，同时拦住默认跳转，
		//    这样搜索引擎能跟着爬，点起来的行为还是原来的（Twikoo 自己的监听器照常跑）
		for (const link of mount.querySelectorAll<HTMLAnchorElement>("a:not([href])")) {
			link.href = "#comments";
			link.addEventListener("click", (event) => event.preventDefault());
		}
	};

	const boot = async () => {
		const mount = document.getElementById("tcomment");
		if (!mount || mount.dataset.ready === "1") return;
		mount.dataset.ready = "1";
		mount.textContent = "";

		// 样式和脚本一起等：**必须先有样式再让 Twikoo 渲染**，
		// 否则冷启动时会先闪一下没样式的评论框。
		await Promise.all([ensureStyles(), loadScript()]);
		await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));

		const global = await waitForGlobal();
		if (!global) {
			mount.textContent = "评论加载失败，刷新一下试试喵";
			return;
		}

		try {
			await global.init({ envId: ENV_ID, el: "#tcomment", path: currentPath(), lang: "zh-CN" });
			polishTwikoo();
			// 评论列表是 init 之后异步渲染的，稍后再补一遍（函数是幂等的）
			window.setTimeout(polishTwikoo, 1200);
		} catch (error) {
			console.error("[Twikoo] 初始化失败：", error);
		}
	};

	const observeComments = () => {
		const section = document.getElementById("comments");
		if (!section) return;

		// 这次会话里已经加载过评论脚本了，直接开
		if (document.querySelector(`script[src="${SCRIPT}"]`)) {
			void boot();
			return;
		}

		if (!("IntersectionObserver" in window)) {
			void boot();
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					observer.disconnect();
					void boot();
				}
			},
			{ rootMargin: "600px 0px" },
		);

		observer.observe(section);
	};

	observeComments();
	document.addEventListener("astro:page-load", observeComments);
</script>
