---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Loader from "../components/Loader.astro";
import PetalLayer from "../components/PetalLayer.astro";
import { site } from "../data/site";
import { localTracks } from "../data/music";
import {
	background,
	buildWallpaperManifest,
	paletteToCssVars,
	pickWallpaper,
} from "../data/background";

interface Props {
	title?: string;
	description?: string;
	/** 这一页马上要请求的第三方/子域接口地址，提前建连能省一个来回 */
	preconnect?: string[];
	/** 分享卡片用的图（og:image），默认用头像；传站点内的绝对路径即可 */
	image?: string;
	/** 结构化数据：页面用 src/data/seo.ts 拼好、序列化之后的 JSON 字符串数组 */
	schema?: string[];
	/** 文章页才有：喂给 og:article 的元数据 */
	publishedTime?: string;
	modifiedTime?: string;
	articleTags?: string[];
	/** og:type，文章页传 "article" */
	type?: string;
	/** 规范链接。传 false 表示这一页不要 canonical（比如 404 页） */
	canonical?: string | false;
}

const {
	title = `${site.title} - ${site.subtitle}`,
	description = site.description,
	preconnect = [],
	image = site.avatar,
	type = "website",
	canonical = new URL(Astro.url.pathname, site.url).href,
	schema = [],
	publishedTime,
	modifiedTime,
	articleTags = [],
} = Astro.props;

const preconnectOrigins = [...new Set(preconnect.filter(Boolean))];
/* 分享卡片必须用绝对地址，相对路径在别人那个客户端里是打不开的 */
const shareImage = new URL(image, site.url).href;

// 智能主题：根据随机挑中的壁纸生成配色变量
const wallpaper = background.mode === "image" ? pickWallpaper() : null;
const manifest = background.mode === "image" ? buildWallpaperManifest() : null;
const themeCss = [
	/*
	 * 用 `:root:root` 提高一层特异性：Astro 会把 tokens.css 之类的样式插到 <head> 末尾，
	 * 同样的 `:root{}` 谁在后面谁生效，壁纸配色就会被默认色盖掉（之前就是这个毛病）。
	 */
	wallpaper?.palette ? `:root:root{${paletteToCssVars(wallpaper.palette)}}` : "",
	wallpaper?.paletteMobile
		? `@media (max-width:768px){:root:root{${paletteToCssVars(wallpaper.paletteMobile)}}}`
		: "",
]
	.filter(Boolean)
	.join("");
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<meta name="generator" content={Astro.generator} />
		{/*
		 * Google Search Console 的站点归属验证（2026-09-25 加）。
		 * 验证码是公开信息，别删 —— 删了 GSC 那边会掉验证。
		 */}
		<meta name="google-site-verification" content="ARQtnQqDx94txPik1lIMHq-u-R4etmkUWpeHTo368pE" />
		{/* 文章页的时间和标签，给机器看的那一份 */}
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{/* 订阅：RSS 全文输出（src/pages/rss.xml.ts 生成） */}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${site.title} - ${site.subtitle}`}
			href="/rss.xml"
		/>
		{/*
		 * 分享卡片（Open Graph / Twitter）。QQ、微信、Discord 这些地方贴链接时靠它出标题和图，
		 * 之前没有这几行，贴出去只有一条光秃秃的 URL。
		 */}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:site_name" content={site.title} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={shareImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />
		{preconnectOrigins.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}
		{/*
		 * 结构化数据（JSON-LD）：网站首页是 WebSite（含站内搜索框），文章页是
		 * BlogPosting + BreadcrumbList，统一由 src/data/seo.ts 拼好传进来。
		 */}
		{schema.map((item) => <script type="application/ld+json" is:inline set:html={item} />)}
		{/* 构建时先烘焙一套配色，禁用 JS 时也能看；下面的脚本会按这次随机到的壁纸覆盖它 */}
		<style id="wallpaper-theme" is:inline set:html={themeCss}></style>
		{
			manifest && (
				<script type="application/json" id="wallpaper-manifest" set:html={JSON.stringify(manifest)} />
			)
		}
		<script is:inline>
			/*
			 * 壁纸要在「首屏那张图开始下载之前」就定下来，否则要么每次刷新都一样，
			 * 要么先下一张再换一张（白白多下一个几百 KB）。
			 * 所以这里在 <head> 里立刻随机挑一张、提前声明下载、并把配色一起换掉。
			 * 放在 head 的脚本在站内路由切换时不会再跑，同一次浏览里壁纸是稳定的。
			 */
			(() => {
				if (window.__yukiWallpaper) return;

				const manifestNode = document.getElementById("wallpaper-manifest");
				if (!manifestNode || !manifestNode.textContent) return;

				let manifest;
				try {
					manifest = JSON.parse(manifestNode.textContent);
				} catch {
					return;
				}

				const desktop = Array.isArray(manifest.desktop) ? manifest.desktop : [];
				if (!desktop.length) return;

				/*
				 * 调试用：?wallpaper=<序号> 可以指定看清单里的第 N 张（清单顺序 = 文件名排序，
				 * 例如 ai-* 在最前、mv-* 在最后）。不写就是随机。
				 */
				const raw = new URLSearchParams(window.location.search).get("wallpaper");
				// 注意：没有这个参数时 get 返回 null，而 Number(null) === 0，会被误当成「指定第 0 张」
				const forced = raw === null ? Number.NaN : Number(raw);
				/*
				 * 只有浏览器「后退 / 前进」时才沿用上一步那张 ——
				 * 正常打开和按 F5 都要重新随机，否则用户会觉得「壁纸不会换」。
				 * 站内切页的配色一致性靠 wallpaper.ts 的模块状态 + applyTheme 保证，不靠这里。
				 */
				let saved = Number.NaN;
				try {
					const navType = performance.getEntriesByType("navigation")[0]?.type ?? "";
					if (navType === "back_forward") {
						const stored = window.sessionStorage.getItem("yuki:wallpaper-index");
						if (stored !== null) saved = Number(stored);
					}
				} catch {
					// 隐私模式读不了，随机即可
				}
				const index =
					Number.isInteger(forced) && forced >= 0 && forced < desktop.length
						? forced
						: Number.isInteger(saved) && saved >= 0 && saved < desktop.length
							? saved
							: Math.floor(Math.random() * desktop.length);
				try {
					window.sessionStorage.setItem("yuki:wallpaper-index", String(index));
				} catch {
					// 忽略
				}
				const mobile = Array.isArray(manifest.mobile) && manifest.mobile.length
					? manifest.mobile[index % manifest.mobile.length]
					: null;

				const isMobile = window.matchMedia("(max-width: 768px)").matches;
				const active = isMobile && mobile ? mobile : desktop[index];

				window.__yukiWallpaper = { index, desktop: desktop[index], mobile, active };

				// 先把这张图声明出来，浏览器会立刻开始下载（尺寸交给 srcset 按屏幕挑）
				const preload = document.createElement("link");
				preload.rel = "preload";
				preload.as = "image";
				preload.setAttribute("fetchpriority", "high");
				if (active.srcSet) {
					preload.setAttribute("imagesrcset", active.srcSet);
					preload.setAttribute("imagesizes", "100vw");
				} else {
					preload.href = active.src;
				}
				document.head.appendChild(preload);

				// 配色跟着这张图走，避免先按烘焙配色画一遍再跳色
				const styleNode = document.getElementById("wallpaper-theme");
				if (styleNode && active.vars) styleNode.textContent = `:root:root{${active.vars}}`;
			})();
		</script>
		<ClientRouter />
	</head>
	<body>
		<Loader />
		<div class="page-backdrop" aria-hidden="true" transition:persist="backdrop"></div>
		<PetalLayer transition:persist="petals" />
		<div class="cursor-glow" aria-hidden="true" transition:persist="glow"></div>
		<div class="scroll-progress" aria-hidden="true" transition:persist="progress"></div>
		<SiteHeader transition:persist="site-header" />
		<div class="page-fade" data-page-fade>
			<slot />
		</div>
		<SiteFooter />
		<button class="to-top" type="button" data-to-top aria-label="回到顶部" transition:persist="to-top">
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M12 19V6M6 12l6-6 6 6"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
		<script
			type="application/json"
			id="music-playlist"
			set:html={JSON.stringify(localTracks)}
		/>
		<script>
			import { init } from "../scripts/effects";
			import { initWallpaper, watchWallpaperBreakpoint } from "../scripts/wallpaper";
			import { initPrefetch } from "../scripts/prefetch";
			import { configureMusic, loadRemotePlaylist } from "../scripts/music";
			import { site } from "../data/site";

			// 播放列表：先装本地 public/audio/ 里扫到的曲目
			const playlistNode = document.getElementById("music-playlist");
			try {
				configureMusic(playlistNode?.textContent ? JSON.parse(playlistNode.textContent) : [], {
					urlApi: site.music.urlApi,
				});
			} catch {
				configureMusic([], { urlApi: site.music.urlApi });
			}

			// 有远程歌单（主人自己的 token 链接）就等页面闲下来再拉，不抢首屏带宽
			if (site.music.api) {
				const warm = () => void loadRemotePlaylist(site.music.api, site.music.cover);
				const idle = (
					window as unknown as {
						requestIdleCallback?: (cb: () => void, options?: { timeout: number }) => number;
					}
				).requestIdleCallback;
				if (idle) idle(warm, { timeout: 3000 });
				else window.setTimeout(warm, 1800);
			}

			init();
			initPrefetch();
			initWallpaper();
			watchWallpaperBreakpoint();
			/*
			 * 切页面时让正文轻轻淡出、新页面再淡入。
			 * 只在「站内跳转」时加这个类，首屏首次绘制不受影响。
			 */
			document.addEventListener("astro:before-preparation", () => {
				document.documentElement.classList.add("is-leaving");
			});
			document.addEventListener("astro:after-swap", () => {
				document.documentElement.classList.remove("is-leaving");
				// 切页后内容立即到位，淡入交给视图过渡
				document.documentElement.classList.add("no-reveal");
			});
			document.addEventListener("astro:page-load", () => {
				init();
				initWallpaper();
			});
		</script>
	</body>
</html>
