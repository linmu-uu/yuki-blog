---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { site } from "../../data/site";
import { collectionSchemas } from "../../data/seo";
import { collectTags, postHref, postsWithTag, tagHref } from "../../data/tags";

/*
 * 标签索引页 /tags/：
 * 每个标签一张卡，卡片里直接把该标签下的文章标题列出来 ——
 * 既是给访客看的目录，也是一组实打实的站内链接（爬虫从这儿能爬到每个标签页和每篇文章）。
 */
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const tags = collectTags(posts);

const description = `站内一共 ${tags.length} 个标签，覆盖 ${posts.length} 篇文章，按文章数量从多到少排列。`;

const dateLabel = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
---

<BaseLayout
	title={`标签 - ${site.title}`}
	description={description}
	schema={collectionSchemas({
		path: "/tags/",
		name: "标签",
		description,
		items: tags.map((tag) => ({
			name: `标签：${tag.name}`,
			url: new URL(tagHref(tag.name), site.url).href,
		})),
	})}
>
	<PageHeader title="标签" description={description}>
		<Breadcrumbs slot="breadcrumb" items={[{ name: "标签" }]} />
	</PageHeader>

	<main class="shell page-body">
		<div class="tag-groups">
			{
				tags.map((tag) => (
					<section class="card tag-group" data-reveal>
						<h2 class="tag-group__title">
							<a href={tagHref(tag.name)}>#{tag.name}</a>
							<span class="tag-group__count">{tag.count} 篇</span>
						</h2>
						<ul class="tag-group__list">
							{postsWithTag(posts, tag.name).map((post) => (
								<li class="tag-group__item">
									<a class="tag-group__link" href={postHref(post.id)}>
										{post.data.title}
									</a>
									<time
										class="tag-group__date"
										datetime={post.data.published.toISOString()}
									>
										{dateLabel.format(post.data.published)}
									</time>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</main>
</BaseLayout>

<style>
	.tag-groups {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--content-gap);
		align-items: start;
	}

	.tag-group {
		padding: var(--space-5);
	}

	.tag-group__title {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin: 0 0 var(--space-4);
		font-size: var(--text-lg);
		font-weight: 700;
	}

	.tag-group__title a {
		color: var(--text);
		transition: color var(--dur) var(--ease-soft);
	}

	.tag-group__title a:hover {
		color: var(--accent-soft);
	}

	.tag-group__count {
		font-size: var(--text-xs);
		font-weight: 400;
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.tag-group__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-group__item {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		padding: 6px 0;
		border-top: 1px solid var(--border);
	}

	.tag-group__item:first-child {
		border-top: none;
	}

	.tag-group__link {
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--text-soft);
		transition: color var(--dur) var(--ease-soft);
	}

	.tag-group__link:hover {
		color: var(--accent-soft);
	}

	.tag-group__date {
		flex-shrink: 0;
		font-size: var(--text-xs);
		color: var(--text-dim);
		font-variant-numeric: tabular-nums;
	}
</style>
