---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import ProfileCard from "../components/ProfileCard.astro";
import MusicCard from "../components/MusicCard.astro";
import TagCloud from "../components/TagCloud.astro";
import PostCard from "../components/PostCard.astro";
import CalendarCard from "../components/CalendarCard.astro";
import { albums } from "../data/gallery";
import { site } from "../data/site";
import { websiteSchemas } from "../data/seo";
import { collectTags, postHref } from "../data/tags";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const tags = collectTags(posts);

/** 日历上要标记的日子：有文章的那天带链接和标题 */
const isoDate = (date: Date) =>
	`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;

const marks = posts.map((post) => ({
	date: isoDate(post.data.published),
	title: post.data.title,
	href: postHref(post.id),
}));

const launchDate = new Date("2026-05-03");
const stats = {
	posts: posts.length,
	tags: tags.length,
	gallery: albums.reduce((sum, album) => sum + album.images.length, 0),
	days: Math.max(1, Math.round((Date.now() - launchDate.getTime()) / 86_400_000)),
};
---

{/* 首页要调音乐接口，提前把连接建好（国内到 Cloudflare 一次握手不便宜） */}
<BaseLayout preconnect={[new URL(site.music.api).origin]} schema={websiteSchemas()}>
	<HeroBanner />

	<main class="shell layout" id="main">
		{/* 左边：个人信息 / 播放器 / 标签，和以前一样 */}
		<aside class="layout__side">
			<ProfileCard />
			<MusicCard />
			<TagCloud tags={tags} />
		</aside>

		<div class="layout__content">
			<h2 class="section-title" data-reveal>最新文章</h2>
			<div class="post-list">
				{
					posts.map((post, index) => (
						<PostCard
							title={post.data.title}
							description={post.data.description}
							href={postHref(post.id)}
							published={post.data.published}
							category={post.data.category}
							tags={post.data.tags}
							delay={index * 90}
							variant={index}
							slug={post.id.replace(/\.(md|mdx)$/, "")}
						/>
					))
				}
			</div>
		</div>

		{/* 右边：日历单独一栏 */}
		<div class="layout__right">
			<CalendarCard marks={marks} stats={stats} />
		</div>
	</main>
</BaseLayout>

<style>
	.layout {
		display: grid;
		/* 左：小组件 ｜ 中：文章 ｜ 右：日历 */
		grid-template-columns: var(--sidebar-width) minmax(0, 1fr) minmax(260px, 320px);
		gap: var(--content-gap);
		align-items: start;
		margin-top: -68px;
		position: relative;
		z-index: 1;
		padding-bottom: var(--space-7);
	}

	.layout__side {
		display: flex;
		flex-direction: column;
		gap: var(--content-gap);
		/* 不再做「内部滚动」：卡片多就让页面自己长，跟随页面滚动最自然 */
	}

	.layout__content {
		min-width: 0;
	}

	.layout__right {
		display: flex;
		flex-direction: column;
		gap: var(--content-gap);
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--content-gap);
	}

	/* 屏幕不够宽就收回单栏：小部件 → 文章 → 日历 */
	@media (max-width: 1200px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			margin-top: calc(var(--space-6) * -1);
		}
	}
</style>
