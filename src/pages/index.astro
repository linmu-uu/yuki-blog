---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import ProfileCard from "../components/ProfileCard.astro";
import MusicCard from "../components/MusicCard.astro";
import TagCloud from "../components/TagCloud.astro";
import PostCard from "../components/PostCard.astro";
import CalendarCard from "../components/CalendarCard.astro";
import { albums } from "../data/gallery";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagCounts.entries()]
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const postHref = (id: string) => `/posts/${id.replace(/\.(md|mdx)$/, "")}/`;

/** 日历上要标记的日子：有文章的那天带链接和标题 */
const isoDate = (date: Date) =>
	`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;

const marks = posts.map((post) => ({
	date: isoDate(post.data.published),
	title: post.data.title,
	href: postHref(post.id),
}));

const launchDate = new Date("2026-05-03");
const stats = {
	posts: posts.length,
	tags: tags.length,
	gallery: albums.reduce((sum, album) => sum + album.images.length, 0),
	days: Math.max(1, Math.round((Date.now() - launchDate.getTime()) / 86_400_000)),
};
---

<BaseLayout>
	<HeroBanner />

	<main class="shell layout" id="main">
		<aside class="layout__side">
			<ProfileCard />
			<CalendarCard marks={marks} stats={stats} />
			<MusicCard />
			<TagCloud tags={tags} />
		</aside>

		<div class="layout__content">
			<h2 class="section-title" data-reveal>最新文章</h2>
			<div class="post-list">
				{
					posts.map((post, index) => (
						<PostCard
							title={post.data.title}
							description={post.data.description}
							href={postHref(post.id)}
							published={post.data.published}
							category={post.data.category}
							tags={post.data.tags}
							delay={index * 90}
							variant={index}
							slug={post.id.replace(/\.(md|mdx)$/, "")}
						/>
					))
				}
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.layout {
		display: grid;
		grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
		gap: var(--content-gap);
		align-items: start;
		margin-top: -68px;
		position: relative;
		z-index: 1;
		padding-bottom: var(--space-7);
	}

	.layout__side {
		display: flex;
		flex-direction: column;
		gap: var(--content-gap);
		position: sticky;
		top: calc(var(--header-height) + var(--space-4));
		/* 侧边栏卡片变多了：超出视口高度时自己滚动，别让下面的卡片看不到 */
		max-height: calc(100vh - var(--header-height) - var(--space-6));
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		padding-right: 4px;
	}

	.layout__side::-webkit-scrollbar {
		width: 6px;
	}

	.layout__side::-webkit-scrollbar-thumb {
		border-radius: var(--radius-full);
		background: rgba(255, 255, 255, 0.12);
	}

	.layout__content {
		min-width: 0;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--content-gap);
	}

	@media (max-width: 1024px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			margin-top: calc(var(--space-6) * -1);
		}

		.layout__side {
			position: static;
		}
	}
</style>
