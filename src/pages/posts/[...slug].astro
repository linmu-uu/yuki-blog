---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comment from "../../components/Comment.astro";
import "../../styles/prose.css";
import { site } from "../../data/site";

export async function getStaticPaths() {
	const posts = await getCollection("posts", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);

const publishedLabel = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "long",
	day: "numeric",
}).format(post.data.published);
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	type="article"
	image={post.data.image || site.avatar}
	preconnect={[site.twikooApi]}
>
	<article class="post">
		<header class="post__header">
			<div class="shell post__header-inner">
				<div class="post__meta">
					<time datetime={post.data.published.toISOString()}>{publishedLabel}</time>
					{post.data.category && <span class="post__category">{post.data.category}</span>}
				</div>
				<h1 class="post__title" transition:name={`title-${post.id.replace(/\.(md|mdx)$/, "")}`}>
					{post.data.title}
				</h1>
				{
					post.data.description && <p class="post__desc">{post.data.description}</p>
				}
				{
					post.data.tags.length > 0 && (
						<ul class="post__tags">
							{post.data.tags.map((tag) => (
								<li>#{tag}</li>
							))}
						</ul>
					)
				}
			</div>
		</header>

		<div class="shell post__body">
			<div class="post__content prose">
				<Content />
			</div>

			{
				toc.length > 0 && (
					<aside class="post__toc" aria-label="文章目录">
						<h2 class="post__toc-title">目录</h2>
						<ul>
							{toc.map((heading) => (
								<li class={`post__toc-item post__toc-item--h${heading.depth}`}>
									<a href={`#${heading.slug}`}>{heading.text}</a>
								</li>
							))}
						</ul>
					</aside>
				)
			}
		</div>

		<div class="shell post__footer">
			<Comment />
		</div>
	</article>
</BaseLayout>

<style>
	.post__header {
		border-bottom: 1px solid var(--border);
		background:
			radial-gradient(58% 130% at 14% 0%, rgba(95, 225, 255, 0.22), transparent 62%),
			radial-gradient(50% 120% at 86% 8%, rgba(95, 225, 255, 0.15), transparent 58%),
			linear-gradient(180deg, rgba(13, 11, 25, 0.9), rgba(8, 7, 15, 0.35));
	}

	.post__header-inner {
		padding-block: var(--space-8) var(--space-6);
		max-width: 900px;
	}

	.post__meta {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		font-size: var(--text-xs);
		color: var(--text-dim);
		letter-spacing: 0.08em;
	}

	.post__category {
		padding: 2px 10px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(95, 225, 255, 0.35);
		background: rgba(95, 225, 255, 0.12);
		color: var(--accent-3);
	}

	.post__title {
		margin: var(--space-4) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 3.6vw, 2.8rem);
		font-weight: 800;
		line-height: 1.25;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 12px 30px rgba(var(--accent-rgb), 0.18));
	}

	.post__desc {
		margin: var(--space-4) 0 0;
		font-size: var(--text-sm);
		line-height: 1.8;
		color: var(--text-muted);
	}

	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin: var(--space-4) 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-xs);
		color: var(--text-dim);
	}

	.post__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 240px;
		gap: var(--space-7);
		align-items: start;
		padding-block: var(--space-7);
	}

	.post__content {
		min-width: 0;
		max-width: 780px;
	}

	.post__toc {
		position: sticky;
		top: calc(var(--header-height) + var(--space-5));
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		backdrop-filter: blur(12px);
		max-height: calc(100vh - var(--header-height) - var(--space-7));
		overflow: auto;
	}

	.post__toc-title {
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		letter-spacing: 0.1em;
		color: var(--text-dim);
	}

	.post__toc ul {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-xs);
		line-height: 1.9;
	}

	.post__toc-item--h3 {
		padding-left: var(--space-4);
	}

	.post__toc a {
		color: var(--text-muted);
		transition: color var(--dur) var(--ease-soft);
	}

	.post__toc a:hover {
		color: var(--accent-soft);
	}

	.post__footer {
		padding-bottom: var(--space-7);
		max-width: 900px;
	}

	@media (max-width: 1024px) {
		.post__body {
			grid-template-columns: minmax(0, 1fr);
		}

		.post__toc {
			position: static;
			max-height: none;
		}
	}
</style>
