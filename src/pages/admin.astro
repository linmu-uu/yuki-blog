---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { albums } from "../data/gallery";

// 相册里的图，发动态时可以直接挑
const galleryImages = albums.flatMap((album) => album.images);
const quickMoods = ["开心", "平静", "期待", "困了", "emo", "兴奋"];
---

<BaseLayout title="动态管理" description="只有站长能发布">
	<main class="shell page-body admin">
		<header class="admin__head">
			<h1>动态管理</h1>
			<p>这个页面谁都能打开，但没有密码就发不了喵。密码只存在你自己的设备上。</p>
		</header>

		<section class="card admin__panel">
			<div class="admin__field">
				<label for="password">管理密码</label>
				<div class="admin__row">
					<input id="password" type="password" placeholder="输入密码" autocomplete="current-password" />
					<button class="admin__btn admin__btn--ghost" id="save-password" type="button">记住</button>
				</div>
				<p class="admin__hint" id="auth-status">密码保存在本机，下次打开这个页面不用重输。</p>
			</div>

			<div class="admin__field">
				<label for="content">正文（支持换行）</label>
				<textarea id="content" rows="5" placeholder="今天发生了什么喵～"></textarea>
			</div>

			<div class="admin__grid">
				<div class="admin__field">
					<label for="mood">心情（可选）</label>
					<input id="mood" list="moods" placeholder="开心" />
					<datalist id="moods">
						{quickMoods.map((mood) => <option value={mood} />)}
					</datalist>
				</div>
				<div class="admin__field">
					<label for="tags">标签（逗号分隔，可选）</label>
					<input id="tags" placeholder="建站, 日常" />
				</div>
			</div>

			<div class="admin__field">
				<label>配图（最多 4 张）</label>
				<div class="admin__upload">
					<button class="admin__btn admin__btn--ghost" id="upload-btn" type="button">
						从电脑选图片
					</button>
					<span class="admin__hint">也可以把图片直接拖到下面这块区域</span>
					<input id="upload-input" type="file" accept="image/*" multiple hidden />
				</div>
				<div class="admin__thumbs" id="picked"></div>
				<details class="admin__picker">
					<summary>或者从相册里挑图</summary>
					<div class="admin__picker-grid" id="picker">
						{
							galleryImages.map((src) => (
								<button type="button" class="admin__pick" data-src={src} aria-label="选用这张图">
									<img src={src} alt="" loading="lazy" />
								</button>
							))
						}
					</div>
				</details>
			</div>

			<div class="admin__actions">
				<button class="admin__btn" id="publish" type="button">发布动态</button>
				<span class="admin__hint" id="status"></span>
			</div>
		</section>

		<section class="card admin__panel">
			<h2 class="admin__subtitle">已有的动态</h2>
			<ul class="admin__list" id="list">
				<li class="admin__hint">加载中…</li>
			</ul>
		</section>
	</main>
</BaseLayout>

<script>
	import { site } from "../data/site";

	interface RemoteMoment {
		id: number;
		date: string;
		content: string;
		mood: string;
		tags: string[];
		images: string[];
	}

	const API = site.momentsApi;
	const PASSWORD_KEY = "yuki:moments-password";
	const MAX_IMAGES = 4;
	const MAX_IMAGE_BYTES = 900 * 1024;
	const picked = new Set<string>();

	const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

	/**
	 * Astro 的 scoped 样式靠 `data-astro-cid-*` 属性匹配元素，
	 * 用 innerHTML 注入的节点没有这个属性，样式会整个失效，所以每次重绘后要补上。
	 */
	const applyScope = (root: Element | null) => {
		if (!root) return;
		const attribute = Array.from(root.attributes)
			.map((item) => item.name)
			.find((name) => name.startsWith("data-astro-cid-"));
		if (!attribute) return;
		root.querySelectorAll("*").forEach((element) => element.setAttribute(attribute, ""));
	};

	const password = () => byId<HTMLInputElement>("password")?.value.trim() ?? "";
	const status = (text: string) => {
		const node = byId("status");
		if (node) node.textContent = text;
	};

	function renderPicked() {
		const box = byId("picked");
		if (!box) return;
		box.innerHTML = [...picked]
			.map(
				(src) =>
					`<span class="admin__thumb"><img src="${src}" alt=""><button type="button" data-src="${src}" aria-label="移除">×</button></span>`,
			)
			.join("");
		applyScope(box);

		for (const button of box.querySelectorAll("button")) {
			button.addEventListener("click", () => {
				picked.delete(button.dataset.src ?? "");
				renderPicked();
			});
		}
	}

	/**
	 * 在浏览器里把图片压小再上传（后端只存压缩后的结果，单张上限 900KB）。
	 * 先等比缩到最长边 1600px 以内，还是太大的话就逐步降尺寸和质量。
	 */
	async function compressImage(file: File): Promise<string> {
		const bitmap = await createImageBitmap(file);
		const steps = [
			{ side: 1600, quality: 0.82 },
			{ side: 1400, quality: 0.72 },
			{ side: 1200, quality: 0.62 },
			{ side: 1000, quality: 0.55 },
		];

		let dataUrl = "";
		for (const step of steps) {
			const scale = Math.min(1, step.side / Math.max(bitmap.width, bitmap.height));
			const canvas = document.createElement("canvas");
			canvas.width = Math.max(1, Math.round(bitmap.width * scale));
			canvas.height = Math.max(1, Math.round(bitmap.height * scale));

			const context = canvas.getContext("2d");
			if (!context) break;
			context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);

			dataUrl = canvas.toDataURL("image/jpeg", step.quality);
			if (dataUrl.length * 0.75 <= MAX_IMAGE_BYTES) break;
		}

		bitmap.close?.();
		return dataUrl;
	}

	/** 选好/拖进来的图片：压缩 → 传到 Worker → 把返回的图片地址记进待发布列表 */
	async function addFiles(files: File[]) {
		const images = files.filter((file) => file.type.startsWith("image/"));
		if (images.length === 0) return;
		if (!password()) {
			status("先填管理密码喵，上传图片要用它");
			return;
		}

		const button = byId<HTMLButtonElement>("upload-btn");
		if (button) button.disabled = true;

		for (const file of images) {
			if (picked.size >= MAX_IMAGES) {
				status(`最多 ${MAX_IMAGES} 张图喵，后面的没上传`);
				break;
			}

			try {
				status(`正在压缩上传 ${file.name}…`);
				const dataUrl = await compressImage(file);

				const response = await fetch(`${API}/api/upload`, {
					method: "POST",
					headers: { "Content-Type": "application/json", Authorization: `Bearer ${password()}` },
					body: JSON.stringify({ dataUrl }),
				});

				if (response.status === 401) {
					status("密码不对喵");
					break;
				}

				const data = (await response.json()) as { ok?: boolean; url?: string; error?: string };
				if (!data.ok || !data.url) {
					status(data.error ?? "上传失败");
					continue;
				}

				picked.add(data.url);
				renderPicked();
				status(`已上传 ${picked.size} 张图 ✓ 记得点发布`);
			} catch (error) {
				status(`上传失败：${String(error)}`);
			}
		}

		if (button) button.disabled = false;
	}

	async function publish() {
		const content = byId<HTMLTextAreaElement>("content")?.value.trim() ?? "";
		if (!content) {
			status("正文还没写呢喵～");
			return;
		}
		if (!password()) {
			status("先填管理密码喵");
			return;
		}

		status("发布中…");
		try {
			const response = await fetch(`${API}/api/moments`, {
				method: "POST",
				headers: { "Content-Type": "application/json", Authorization: `Bearer ${password()}` },
				body: JSON.stringify({
					content,
					mood: byId<HTMLInputElement>("mood")?.value ?? "",
					tags: (byId<HTMLInputElement>("tags")?.value ?? "")
						.split(/[,，]/)
						.map((tag) => tag.trim())
						.filter(Boolean),
					images: [...picked],
				}),
			});

			if (response.status === 401) {
				status("密码不对喵");
				return;
			}

			const data = (await response.json()) as { ok?: boolean; error?: string };
			if (!data.ok) {
				status(data.error ?? "发布失败");
				return;
			}

			status("发布成功 ✓ 现在打开动态页就能看到了");
			const textarea = byId<HTMLTextAreaElement>("content");
			if (textarea) textarea.value = "";
			picked.clear();
			renderPicked();
			loadList();
		} catch (error) {
			status(`发布失败：${String(error)}`);
		}
	}

	async function loadList() {
		const list = byId("list");
		if (!list) return;
		try {
			const data = (await (
				await fetch(`${API}/api/moments`, { cache: "no-store" })
			).json()) as RemoteMoment[];

			if (!Array.isArray(data) || data.length === 0) {
				list.innerHTML = '<li class="admin__hint">还没有动态</li>';
				applyScope(list);
				return;
			}

			list.innerHTML = data
				.map(
					(moment) => `<li>
						<time>${moment.date}${moment.mood ? ` · ${moment.mood}` : ""}</time>
						<p>${moment.content.replace(/</g, "&lt;").replace(/\n/g, "<br>")}</p>
						<button type="button" class="admin__del" data-id="${moment.id}">删除</button>
					</li>`,
				)
				.join("");
			applyScope(list);

			for (const button of list.querySelectorAll<HTMLButtonElement>(".admin__del")) {
				button.addEventListener("click", async () => {
					if (!password()) {
						status("先填管理密码喵");
						return;
					}
					if (!window.confirm("确定删除这条动态吗？")) return;
					const response = await fetch(`${API}/api/moments/${button.dataset.id}`, {
						method: "DELETE",
						headers: { Authorization: `Bearer ${password()}` },
					});
					status(response.ok ? "已删除" : "删除失败");
					loadList();
				});
			}
		} catch {
			list.innerHTML = '<li class="admin__hint">加载失败，检查一下网络</li>';
			applyScope(list);
		}
	}

	function setup() {
		const input = byId<HTMLInputElement>("password");
		const authStatus = byId("auth-status");
		if (!input || input.dataset.bound === "1") return;
		input.dataset.bound = "1";

		const saved = window.localStorage.getItem(PASSWORD_KEY);
		if (saved) {
			input.value = saved;
			if (authStatus) authStatus.textContent = "已读取之前保存的密码 ✓";
		}

		byId("save-password")?.addEventListener("click", () => {
			window.localStorage.setItem(PASSWORD_KEY, input.value.trim());
			if (authStatus) authStatus.textContent = "密码已保存在这台设备上 ✓";
		});

		byId("publish")?.addEventListener("click", publish);

		const uploadButton = byId<HTMLButtonElement>("upload-btn");
		const uploadInput = byId<HTMLInputElement>("upload-input");

		uploadButton?.addEventListener("click", () => uploadInput?.click());
		uploadInput?.addEventListener("change", () => {
			void addFiles(Array.from(uploadInput.files ?? []));
			uploadInput.value = "";
		});

		// 拖拽上传：按钮那一行和下面放缩略图的区域都能接
		for (const zone of [uploadButton?.closest(".admin__upload"), byId("picked")]) {
			if (!zone) continue;
			zone.addEventListener("dragover", (event) => {
				event.preventDefault();
				zone.classList.add("is-dragging");
			});
			zone.addEventListener("dragleave", () => zone.classList.remove("is-dragging"));
			zone.addEventListener("drop", (event) => {
				const dragEvent = event as DragEvent;
				dragEvent.preventDefault();
				zone.classList.remove("is-dragging");
				void addFiles(Array.from(dragEvent.dataTransfer?.files ?? []));
			});
		}

		// 图片拖到页面别的地方时，别让浏览器直接把它打开
		document.addEventListener("dragover", (event) => event.preventDefault());
		document.addEventListener("drop", (event) => event.preventDefault());

		for (const button of document.querySelectorAll<HTMLButtonElement>(".admin__pick")) {
			button.addEventListener("click", () => {
				const src = button.dataset.src ?? "";
				if (!src) return;
				if (picked.has(src)) {
					picked.delete(src);
				} else if (picked.size < 4) {
					picked.add(src);
				} else {
					status("最多 4 张图喵");
				}
				renderPicked();
			});
		}

		loadList();
	}

	setup();
	document.addEventListener("astro:page-load", setup);
</script>

<style>
	.admin {
		max-width: 820px;
	}

	.admin__head h1 {
		margin: 0 0 var(--space-2);
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.4vw, 2.4rem);
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.admin__head p {
		margin: 0 0 var(--space-5);
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.admin__panel {
		padding: var(--space-5);
		margin-bottom: var(--space-5);
	}

	.admin__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}

	.admin__field + .admin__field,
	.admin__grid + .admin__field,
	.admin__field + .admin__actions {
		margin-top: var(--space-4);
	}

	.admin label {
		display: block;
		margin-bottom: var(--space-2);
		font-size: var(--text-xs);
		letter-spacing: 0.1em;
		color: var(--text-dim);
	}

	.admin input,
	.admin textarea {
		width: 100%;
		padding: 11px 14px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: rgba(255, 255, 255, 0.05);
		color: var(--text);
		font-family: inherit;
		font-size: var(--text-sm);
		line-height: 1.8;
		outline: none;
		resize: vertical;
	}

	.admin input:focus,
	.admin textarea:focus {
		border-color: rgba(var(--accent-rgb), 0.6);
	}

	.admin__row {
		display: flex;
		gap: var(--space-2);
	}

	.admin__hint {
		margin: var(--space-2) 0 0;
		font-size: var(--text-xs);
		color: var(--text-dim);
	}

	.admin__actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-5);
	}

	.admin__btn {
		padding: 10px 24px;
		border-radius: var(--radius-full);
		border: none;
		font-size: var(--text-sm);
		font-weight: 700;
		color: #06101f;
		background: var(--gradient-accent);
		box-shadow: 0 14px 30px -16px rgba(var(--accent-rgb), 0.9);
		transition: transform var(--dur) var(--ease-spring);
	}

	.admin__btn:hover {
		transform: translateY(-2px);
	}

	.admin__btn--ghost {
		color: var(--text);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--border);
		box-shadow: none;
	}

	.admin__btn:disabled {
		opacity: 0.6;
		cursor: progress;
		transform: none;
	}

	.admin__upload.is-dragging,
	.admin__thumbs.is-dragging {
		border-radius: var(--radius-sm);
		outline: 1px dashed rgba(var(--accent-rgb), 0.75);
		outline-offset: 4px;
	}

	.admin__thumbs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.admin__thumb {
		position: relative;
		width: 92px;
		height: 68px;
		border-radius: var(--radius-sm);
		overflow: hidden;
		border: 1px solid var(--border);
	}

	.admin__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.admin__thumb button {
		position: absolute;
		top: 3px;
		right: 3px;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		border: none;
		background: rgba(4, 7, 15, 0.82);
		color: #fff;
		line-height: 1;
		cursor: pointer;
	}

	.admin__picker {
		margin-top: var(--space-3);
	}

	.admin__picker summary {
		cursor: pointer;
		font-size: var(--text-xs);
		color: var(--accent-soft);
	}

	.admin__picker-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
		gap: var(--space-2);
		margin-top: var(--space-3);
		max-height: 300px;
		overflow: auto;
		padding-right: 4px;
	}

	.admin__pick {
		padding: 0;
		border-radius: var(--radius-sm);
		overflow: hidden;
		border: 1px solid var(--border);
		cursor: pointer;
		aspect-ratio: 4 / 3;
	}

	.admin__pick img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.admin__pick:hover {
		border-color: rgba(var(--accent-rgb), 0.6);
	}

	.admin__subtitle {
		margin: 0 0 var(--space-4);
		font-size: var(--text-base);
	}

	.admin__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.admin__list li {
		position: relative;
		padding: var(--space-4) 0;
		border-bottom: 1px dashed var(--border);
	}

	.admin__list li:last-child {
		border-bottom: none;
	}

	.admin__list time {
		font-size: var(--text-xs);
		color: var(--text-dim);
	}

	.admin__list p {
		margin: var(--space-2) 0 0;
		font-size: var(--text-sm);
		line-height: 1.8;
		color: var(--text-soft);
	}

	.admin__del {
		position: absolute;
		top: var(--space-4);
		right: 0;
		padding: 4px 12px;
		border-radius: var(--radius-full);
		border: 1px solid rgba(255, 120, 150, 0.4);
		background: rgba(255, 90, 130, 0.12);
		color: #ffb3c5;
		font-size: var(--text-xs);
		cursor: pointer;
	}

	@media (max-width: 768px) {
		.admin__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
