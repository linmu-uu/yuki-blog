# Cloudflare Workers 静态资源缓存策略
#
# 两条原则：
#   1. 带内容哈希的产物（/_astro/*）永久缓存；图片/音频这类不带哈希的缓存一天
#   2. HTML 页面用 max-age=0 + stale-while-revalidate：浏览器可以先用缓存秒开
#      （配合 hover 预取，切栏目就不会卡），同时在后台重新验证，内容最多一分钟更新
#
# 注意：HTML 的规则必须写在资源规则之后 —— 同一路径如果都匹配，后面的规则生效。
# 比如 /gallery/ 这个目录页既匹配 /gallery/* 也匹配 /gallery/，靠顺序让 HTML 规则赢，
# 否则页面会被当成图片缓存一整天，部署完还看到旧版。

# ---------- 静态资源 ----------

# Astro 构建产物：文件名里带内容哈希，内容永不改变，可以缓存一年
/_astro/*
  Cache-Control: public, max-age=31556952, immutable

# 站点公共资源（Twikoo 前端、图标等，不带哈希）：缓存一天
/assets/*
  Cache-Control: public, max-age=86400

# 图库里的图片：缓存一天。
# 注意两点 Cloudflare 的行为：
#   1. _headers 多条命中是「叠加」而不是覆盖
#   2. 通配符 * 不跨 "/"
# 所以这里按相册目录逐个写，而不是写 /gallery/* —— 后者会把 /gallery/ 目录页
# 也套上 86400，部署后可能一整天看到旧页面。（新增相册时记得加一行）
/gallery/blue-archive/*
  Cache-Control: public, max-age=86400

/gallery/firefly-2026/*
  Cache-Control: public, max-age=86400

# 壁纸：缓存一天
/wallpaper/*
  Cache-Control: public, max-age=86400

# 音乐：缓存一天
/audio/*
  Cache-Control: public, max-age=86400

# 站点图标与头像：缓存一周
/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/avatar.avif
  Cache-Control: public, max-age=604800

# ---------- HTML 页面 ----------

/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/archive/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/moments/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/gallery/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/friends/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/guestbook/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/about/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/admin/
  Cache-Control: public, max-age=0, stale-while-revalidate=120

/posts/*
  Cache-Control: public, max-age=0, stale-while-revalidate=120
