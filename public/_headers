# Cloudflare Workers 静态资源缓存策略
#
# 背景：Workers 静态资源默认返回 Cache-Control: public, must-revalidate, max-age=0，
# 导致回访时浏览器要对每个 JS/CSS/图片重新发一次请求（跨境一次往返 100~300ms），
# 20 多个资源累加起来就很慢。下面的规则让静态资源在浏览器端真正缓存住。
#
# 注意：HTML 保持默认的 max-age=0，这样每次部署后访客立刻能看到新内容。

# Astro 构建产物：文件名里带内容哈希，内容永不改变，可以缓存一年
/_astro/*
  Cache-Control: public, max-age=31556952, immutable

# 站点公共资源（Twikoo 前端、图标等，不带哈希）：缓存一天
/assets/*
  Cache-Control: public, max-age=86400

# 图库：缓存一天
/gallery/*
  Cache-Control: public, max-age=86400

# 壁纸：缓存一天
/wallpaper/*
  Cache-Control: public, max-age=86400

# 音乐：缓存一天
/audio/*
  Cache-Control: public, max-age=86400

# 站点图标与头像：缓存一周
/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/avatar.avif
  Cache-Control: public, max-age=604800
